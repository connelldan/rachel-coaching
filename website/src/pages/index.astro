---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Home" description="Rachel Connell Coaching | Empowering Christian women to live with purpose, clarity, and confidence through professional coaching.">
  <Header />

  <!-- ===== Hero Section ===== -->
  <section class="hero">
    <div class="hero__bg">
      <img src="/images/botanical-texture.jpg" alt="" class="hero__bg-img" aria-hidden="true" />
      <div class="hero__bg-overlay"></div>
    </div>

    <div class="hero__content container">
      <div class="hero__text">
        <span class="eyebrow animate-in">Professional Christian Coaching</span>
        <h1 class="hero__title animate-in animate-in--delay-1">
          Know your purpose.<br />
          <span class="serif-italic">Live intentionally.</span>
        </h1>
        <p class="lead animate-in animate-in--delay-2">
          Don't merely exist. Coaching is a tool to peel back distractions, expose the lies you believe, and set you firmly on the path God has written out for you.
        </p>
        <div class="hero__actions animate-in animate-in--delay-3">
          <a href="/contact" class="btn btn--primary">Book a Free Discovery Call</a>
          <a href="/about" class="btn btn--outline">Learn More</a>
        </div>
      </div>
      <div class="hero__image animate-in animate-in--delay-2">
        <div class="hero__image-frame">
          <img src="/images/hero-portrait.jpg" alt="A woman journaling in a cozy, sunlit space" />
        </div>
        <div class="hero__image-accent"></div>
      </div>
    </div>

    <div class="hero__scroll">
      <div class="hero__scroll-line"></div>
    </div>
  </section>

  <!-- ===== Philosophy Section ===== -->
  <section class="section section--white" id="philosophy">
    <div class="container">
      <div class="philosophy" data-animate>
        <div class="philosophy__content text-center">
          <span class="eyebrow">My Philosophy</span>
          <h2>A soft landing place <br /><span class="serif-italic">and a launchpad forward.</span></h2>
          <div class="divider divider--center"></div>
          <p class="lead" style="margin: 0 auto;">
            Coaching is a place where you can come when the path in front of you feels turbulent. Whether it's due to a lack of clarity, insecurity, upheaval in your life, or a general sense of disappointment, coaching can be a soft landing place.
          </p>
          <p style="margin: var(--space-sm) auto 0;">
            But in coaching you don't just stay there; you gain the insight and tools necessary to take the next step on your path. Not someone else's journey and not a mediocre journey of your own creation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Who I Coach Section ===== -->
  <section class="section section--cream" id="who">
    <div class="container">
      <div class="grid-2">
        <div class="who__image" data-animate="slide-left">
          <div class="img-frame">
            <img src="/images/lifestyle-flatlay.jpg" alt="Bible and journal with coffee on a wooden table" />
          </div>
        </div>
        <div class="who__content" data-animate="slide-right">
          <span class="eyebrow">Who I Coach</span>
          <h2>Christian women in every season</h2>
          <div class="divider"></div>
          <p>
            I coach Christian women throughout the many different seasons they find themselves in. They are women who hold their faith in Christ dearly, and who desire not to just do life <em>for</em> God, but to do it <em>with</em> Him.
          </p>
          <p>
            You might be a college student launching into adulthood, a few years into your career navigating marriage and family, or further along wondering "now what?" Coaching is for you, because each moment of your life is significant.
          </p>
          <a href="/about" class="btn btn--primary">Read My Story</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Services Overview ===== -->
  <section class="section" id="services-overview">
    <div class="container text-center">
      <span class="eyebrow" data-animate>Services</span>
      <h2 data-animate>How we can work together</h2>
      <div class="divider divider--center" data-animate></div>

      <div class="services-grid">
        <div class="service-card card" data-animate>
          <div class="service-card__icon">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5"/>
              <path d="M17 24c0-3.866 3.134-7 7-7s7 3.134 7 7-3.134 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="24" cy="24" r="2" fill="currentColor"/>
            </svg>
          </div>
          <h3>1:1 Coaching</h3>
          <p>Personalized coaching sessions tailored to your unique season and goals. Available in 4, 8, and 12-week packages with weekly or biweekly options.</p>
          <a href="/services" class="btn btn--outline">View Packages</a>
        </div>

        <div class="service-card card" data-animate>
          <div class="service-card__icon">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="6" y="8" width="36" height="32" rx="4" stroke="currentColor" stroke-width="1.5"/>
              <path d="M6 18h36M16 8V4M32 8V4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="24" cy="28" r="4" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <h3>Free Discovery Call</h3>
          <p>A complimentary 30-minute call to discuss what you desire out of coaching, where you are, and which package makes the most sense for your goals.</p>
          <a href="/contact" class="btn btn--primary">Schedule Now</a>
        </div>

        <div class="service-card card" data-animate>
          <div class="service-card__icon">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 14c0-2 2-6 12-6s12 4 12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M12 14v20c0 2 2 6 12 6s12-4 12-6V14" stroke="currentColor" stroke-width="1.5"/>
              <path d="M12 24c0 2 2 6 12 6s12-4 12-6" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <h3>Group Coaching</h3>
          <p>A specialized program designed for college women navigating the complexities of launching into adulthood with faith and confidence. <em>Coming soon.</em></p>
          <a href="/contact" class="btn btn--outline">Join the Waitlist</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Quote Banner ===== -->
  <section class="quote-banner section--sage">
    <div class="container text-center" data-animate>
      <blockquote class="quote-banner__text">
        Christian women, we are meant to be powerful tools on this earth in the Hands of our Father. This world is distracting, and coaching is a tool to peel back those distractions and set you firmly on the path God has written out for you.
      </blockquote>
    </div>
  </section>

  <!-- ===== How It Works ===== -->
  <section class="section section--white" id="how-it-works">
    <div class="container">
      <div class="text-center" data-animate>
        <span class="eyebrow">The Process</span>
        <h2>How it works</h2>
        <div class="divider divider--center"></div>
      </div>

      <div class="steps">
        <div class="step" data-animate>
          <div class="step__number">01</div>
          <div class="step__content">
            <h3>Discovery Call</h3>
            <p>Schedule a free 30-minute call. We'll discuss what you desire out of coaching, where you are, and what you're navigating.</p>
          </div>
        </div>
        <div class="step" data-animate>
          <div class="step__number">02</div>
          <div class="step__content">
            <h3>Choose Your Package</h3>
            <p>Together we'll determine which coaching package makes the most sense for you: 4, 8, or 12 weeks, meeting weekly or biweekly.</p>
          </div>
        </div>
        <div class="step" data-animate>
          <div class="step__number">03</div>
          <div class="step__content">
            <h3>Begin the Journey</h3>
            <p>Complete your coaching agreement and intake form, and we begin 50-minute virtual sessions in support of your goals and desires.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA Section ===== -->
  <section class="cta-section">
    <div class="cta-section__bg">
      <img src="/images/botanical-texture.jpg" alt="" aria-hidden="true" />
    </div>
    <div class="cta-section__overlay"></div>
    <div class="container text-center cta-section__content" data-animate>
      <span class="eyebrow" style="color: var(--color-cream-light);">Ready to begin?</span>
      <h2 style="color: var(--color-warm-white);">Your journey starts with a conversation</h2>
      <p class="lead" style="color: rgba(255,253,249,0.8); margin: 0 auto var(--space-lg);">
        I hope to partner with you in your journey. Schedule a free 30-minute discovery call and let's explore how coaching can support you.
      </p>
      <a href="/contact" class="btn btn--white">Book Your Free Call!</a>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* ===== Hero ===== */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: var(--nav-height);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.15;
  }

  .hero__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-cream-light) 40%, rgba(245, 237, 227, 0.6) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
    padding: var(--space-xl) var(--space-md);
  }

  .hero__title {
    margin-bottom: var(--space-md);
    color: var(--color-charcoal);
  }

  .hero__title .serif-italic {
    color: var(--color-terracotta);
    font-size: 0.9em;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-lg);
  }

  .hero__image {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .hero__image-frame {
    position: relative;
    z-index: 1;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(58, 53, 48, 0.15);
    max-width: 420px;
  }

  .hero__image-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero__image-accent {
    position: absolute;
    top: -20px;
    right: -20px;
    width: 100%;
    height: 100%;
    max-width: 420px;
    border-radius: var(--radius-xl);
    border: 2px solid var(--color-sage-light);
    z-index: 0;
    opacity: 0.4;
  }

  .hero__scroll {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
  }

  .hero__scroll-line {
    width: 1px;
    height: 50px;
    background: linear-gradient(to bottom, var(--color-terracotta), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.6); }
    50% { opacity: 1; transform: scaleY(1); }
  }

  /* ===== Services Grid ===== */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .service-card {
    text-align: center;
    padding: var(--space-xl) var(--space-lg);
  }

  .service-card__icon {
    color: var(--color-terracotta);
    margin-bottom: var(--space-md);
    display: flex;
    justify-content: center;
  }

  .service-card h3 {
    margin-bottom: var(--space-sm);
  }

  .service-card p {
    margin: 0 auto var(--space-md);
    color: var(--color-text-light);
  }

  /* ===== Quote Banner ===== */
  .quote-banner {
    padding: var(--space-3xl) 0;
  }

  .quote-banner__text {
    border-left: none;
    color: var(--color-warm-white);
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    max-width: 800px;
    margin: 0 auto;
    padding: 0;
    opacity: 0.95;
  }

  .quote-banner__cite {
    display: block;
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255, 253, 249, 0.5);
    margin-top: var(--space-md);
  }

  /* ===== Steps ===== */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  .step {
    text-align: center;
  }

  .step__number {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 300;
    color: var(--color-sage-light);
    line-height: 1;
    margin-bottom: var(--space-sm);
  }

  .step__content h3 {
    margin-bottom: 0.5rem;
  }

  .step__content p {
    color: var(--color-text-light);
    margin: 0 auto;
  }

  /* ===== CTA Section ===== */
  .cta-section {
    position: relative;
    padding: var(--space-3xl) 0;
    overflow: hidden;
  }

  .cta-section__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-section__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-section__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(142, 85, 48, 0.9), rgba(107, 125, 94, 0.85));
    z-index: 1;
  }

  .cta-section__content {
    position: relative;
    z-index: 2;
  }

  /* ===== Responsive ===== */
  @media (max-width: 1024px) {
    .hero__content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero__actions {
      justify-content: center;
    }

    .hero__image {
      order: -1;
    }

    .hero__image-frame {
      max-width: 320px;
    }

    .hero__image-accent {
      max-width: 320px;
    }

    .services-grid {
      grid-template-columns: 1fr;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }

    .steps {
      grid-template-columns: 1fr;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--nav-height) + var(--space-lg));
      padding-bottom: var(--space-xl);
    }

    .hero__scroll {
      display: none;
    }
  }
</style>
