---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout 
  title="Rooted to Flourish Workbook" 
  description="Sign up to receive my free workbook for undergrad women who desire to move forward with purpose and intention."
>
  <Header />

  <!-- ===== Page Hero ===== -->
  <section class="page-hero">
    <div class="page-hero__bg">
      <img src="/images/botanical-leaf-texture-background.jpg" alt="" aria-hidden="true" />
      <div class="page-hero__overlay"></div>
    </div>
    <div class="container page-hero__content text-center">
      <div style="margin-bottom: var(--space-xs);">
        <a href="/free-resources" style="color: var(--color-cream-light); font-size: 0.9rem; text-decoration: underline; opacity: 0.85;">← Back to Free Resources</a>
      </div>
      <span class="eyebrow animate-in" style="color: var(--color-cream-light);">Free Reflection Workbook</span>
      <h1 class="animate-in animate-in--delay-1" style="color: var(--color-warm-white);">Rooted to Flourish</h1>
    </div>
  </section>

  <!-- ===== Resource Detail & Download Form ===== -->
  <section class="section section--white">
    <div class="container">
      <div class="resource-detail-grid">
        <!-- Cover & Overview -->
        <div class="resource-cover-col" data-animate="slide-right">
          <div class="cover-card">
            <img 
              src="/images/rooted-to-flourish-workbook-cover.jpg" 
              alt="Rooted to Flourish: A reflection workbook for undergraduate women cover"
              class="workbook-cover-img"
            />
          </div>
        </div>

        <!-- Description & Form -->
        <div class="resource-content-col" data-animate="slide-left">
          <span class="eyebrow">For Undergraduate Women</span>
          <h2>Move forward with <span class="serif-italic">purpose & intention</span></h2>
          <div class="divider"></div>

          <p class="lead">
            Sign up below to receive my free workbook for undergrad women who desire to move forward with purpose and intention.
          </p>
          <p>
            It is so easy to drift through life, especially the college years given the excitement, stress, and busyness of it all. But anytime we let ourselves drift, we often find ourselves in places we did not intend to go.
          </p>
          <p>
            This workbook takes you through a journey of honest reflection, challenging and encouraging you to take ownership of walking the path God has laid out for you. I hope you enjoy!
          </p>

          <div class="card resource-form-card" style="margin-top: var(--space-lg);">
            <h3 style="margin-bottom: var(--space-md);">Get Your Free Copy</h3>
            
            <form class="resource-form" id="resource-form" action="#" method="POST">
              <div class="form-row">
                <div class="form-group">
                  <label for="first-name" class="form-label">First Name <span class="required">*</span></label>
                  <input type="text" id="first-name" name="firstName" class="form-input" required placeholder="Your first name" />
                </div>
                <div class="form-group">
                  <label for="last-name" class="form-label">Last Name <span class="required">*</span></label>
                  <input type="text" id="last-name" name="lastName" class="form-input" required placeholder="Your last name" />
                </div>
              </div>

              <div class="form-group">
                <label for="email" class="form-label">Email Address <span class="required">*</span></label>
                <input type="email" id="email" name="email" class="form-input" required placeholder="you@example.com" />
              </div>

              <button type="submit" class="btn btn--primary form-submit" id="form-submit">
                <span class="form-submit__text">Download Now</span>
                <span class="form-submit__loading" style="display:none;">Processing...</span>
              </button>
            </form>

            <div class="form-success" id="form-success" style="display:none; text-align: center; padding: var(--space-lg) 0;">
              <div class="form-success__icon" style="width: 48px; height: 48px; border-radius: 50%; background: var(--color-sage); color: white; display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-sm); font-size: 1.2rem;">✓</div>
              <h3 style="color: var(--color-sage-dark);">Success!</h3>
              <p>Your download should start automatically. If it doesn't, <a href="/downloads/rooted-to-flourish-workbook.pdf" download="rooted-to-flourish-workbook.pdf" style="color: var(--color-terracotta); text-decoration: underline;">click here</a> to download.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  const form = document.getElementById('resource-form');
  const success = document.getElementById('form-success');
  const submitBtn = document.getElementById('form-submit');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const textEl = submitBtn?.querySelector('.form-submit__text');
      const loadingEl = submitBtn?.querySelector('.form-submit__loading');
      if (textEl) (textEl as HTMLElement).style.display = 'none';
      if (loadingEl) (loadingEl as HTMLElement).style.display = 'inline';

      const formData = new FormData(form as HTMLFormElement);
      
      formData.append("access_key", "4a86b495-300e-453c-94ae-1c65bf932828");
      
      const name = formData.get("firstName") || "Someone";
      formData.append("subject", `New Workbook Download from ${name}`);
      formData.append("from_name", "Rachel Connell Coaching Website");

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData
        });

        const data = await response.json();

        if (data.success) {
          (form as HTMLElement).style.display = 'none';
          if (success) success.style.display = 'block';

          const link = document.createElement('a');
          link.href = '/downloads/rooted-to-flourish-workbook.pdf';
          link.download = 'rooted-to-flourish-workbook.pdf';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        } else {
          alert("Oops! Something went wrong. Please try emailing directly at rachel@rachelconnellcoaching.com");
        }
      } catch (error) {
        console.error("Error submitting form:", error);
        alert("Oops! Something went wrong. Please try emailing directly at rachel@rachelconnellcoaching.com");
      } finally {
        if (textEl) (textEl as HTMLElement).style.display = 'inline';
        if (loadingEl) (loadingEl as HTMLElement).style.display = 'none';
      }
    });
  }
</script>

<style>
  /* ===== Page Hero ===== */
  .page-hero {
    position: relative;
    padding: calc(var(--nav-height) + var(--space-3xl)) 0 var(--space-xl);
    overflow: hidden;
    min-height: 280px;
    display: flex;
    align-items: flex-end;
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
  }

  .page-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(142, 85, 48, 0.85), rgba(107, 125, 94, 0.8));
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
  }

  /* ===== Resource Detail Grid ===== */
  .resource-detail-grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .cover-card {
    background: var(--color-warm-white);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    box-shadow: 0 16px 40px rgba(58, 53, 48, 0.12);
    border: 1px solid var(--color-cream-dark);
    text-align: center;
  }

  .workbook-cover-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    display: block;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  }

  .resource-form-card {
    padding: var(--space-xl);
    background: var(--color-cream);
    border-radius: var(--radius-lg);
  }

  /* ===== Form Styles ===== */
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .form-group {
    margin-bottom: var(--space-md);
  }

  .form-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--color-text);
    margin-bottom: 0.4rem;
    letter-spacing: 0.03em;
  }

  .required {
    color: var(--color-terracotta);
  }

  .form-input {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1.5px solid var(--color-cream-dark);
    border-radius: var(--radius-md);
    background: var(--color-warm-white);
    color: var(--color-text);
    font-size: 0.95rem;
    transition: all var(--transition-base);
    outline: none;
  }

  .form-input:focus {
    border-color: var(--color-terracotta-light);
    box-shadow: 0 0 0 3px rgba(176, 106, 59, 0.1);
  }

  .form-input::placeholder {
    color: var(--color-text-lighter);
  }

  .form-submit {
    width: 100%;
    margin-top: var(--space-sm);
  }

  /* ===== Responsive ===== */
  @media (max-width: 960px) {
    .resource-detail-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .cover-card {
      max-width: 340px;
      margin: 0 auto;
    }
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
