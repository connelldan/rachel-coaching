---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsletterEmbed from '../components/NewsletterEmbed.astro';
---

<BaseLayout
  title="Blog"
  description="Receive blogs and biblical reflections directly to your inbox from Rachel Connell Coaching."
>
  <Header />

  <!-- ===== Page Hero ===== -->
  <section class="page-hero">
    <div class="page-hero__bg">
      <img src="/images/botanical-leaf-texture-background.jpg" alt="" aria-hidden="true" />
      <div class="page-hero__overlay"></div>
    </div>
    <div class="container page-hero__content text-center">
      <span class="eyebrow animate-in" style="color: var(--color-cream-light);">Reflections & Insights</span>
      <h1 class="animate-in animate-in--delay-1" style="color: var(--color-warm-white);">The Blog</h1>
      <p class="page-hero__lead animate-in animate-in--delay-2">
        Receive blogs directly to your inbox when you sign up for my newsletter here.
      </p>
    </div>
  </section>

  <!-- ===== Newsletter Subscription Section ===== -->
  <section class="section section--white" id="subscribe">
    <div class="container container--narrow text-center" data-animate>
      <span class="eyebrow">Direct to Your Inbox</span>
      <h2>Join the <span class="serif-italic">Newsletter</span></h2>
      <div class="divider divider--center"></div>
      <p class="lead" style="margin-bottom: var(--space-xl); max-width: 600px; margin-left: auto; margin-right: auto;">
        Sign up below to receive fresh reflections, coaching insights, and new writings as soon as they are published.
      </p>
      
      <div class="newsletter-card card">
        <NewsletterEmbed />
      </div>

      <!-- Encouragement Banner -->
      <div class="blog-banner card" data-animate style="margin-top: var(--space-2xl);">
        <div class="blog-banner__content">
          <span class="eyebrow" style="color: var(--color-terracotta);">Ready to take the next step?</span>
          <h3>Looking for support in your current season?</h3>
          <p>
            Coaching is a space to explore what is meaningful for you and step forward with purpose. If you are navigating a transition and want personalized support, let's connect.
          </p>
        </div>
        <div class="blog-banner__action">
          <a href="/contact" class="btn btn--primary">Book a Free Discovery Call</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* ===== Page Hero ===== */
  .page-hero {
    position: relative;
    padding-top: calc(var(--nav-height) + var(--space-2xl));
    padding-bottom: var(--space-2xl);
    background: var(--color-charcoal);
    overflow: hidden;
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
  }

  .page-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(58, 53, 48, 0.7) 0%, rgba(58, 53, 48, 0.9) 100%);
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .page-hero__lead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: rgba(255, 253, 249, 0.85);
    margin: var(--space-md) auto 0;
  }

  .newsletter-card {
    background: var(--color-warm-white);
    border: 1px solid var(--color-cream-dark);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    box-shadow: 0 4px 20px rgba(58, 53, 48, 0.05);
  }

  /* ===== Encouragement Banner ===== */
  .blog-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: var(--space-xl);
    background: var(--color-cream);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-cream-dark);
  }

  .blog-banner__content {
    max-width: 650px;
    text-align: left;
  }

  .blog-banner__content h3 {
    font-size: 1.6rem;
    margin-top: 0.3rem;
    margin-bottom: var(--space-xs);
  }

  .blog-banner__content p {
    font-size: 0.98rem;
    color: var(--color-text-light);
    margin: 0;
  }

  .blog-banner__action {
    flex-shrink: 0;
  }

  /* ===== Responsive ===== */
  @media (max-width: 1024px) {
    .blog-banner {
      flex-direction: column;
      text-align: center;
      gap: var(--space-md);
    }

    .blog-banner__content {
      text-align: center;
    }
  }

  @media (max-width: 768px) {
    .page-hero {
      padding-top: calc(var(--nav-height) + var(--space-lg));
      padding-bottom: var(--space-xl);
    }

    .newsletter-card {
      padding: var(--space-md);
    }

    .blog-banner {
      padding: var(--space-lg);
    }
  }
</style>
