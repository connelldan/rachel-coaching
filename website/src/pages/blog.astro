---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Blog"
  description="Reflections, insights, and biblical encouragement on faith, purpose, and navigating life's seasons from Rachel Connell Coaching."
>
  <Header />

  <!-- ===== Page Hero ===== -->
  <section class="page-hero">
    <div class="page-hero__bg">
      <img src="/images/botanical-texture.jpg" alt="" aria-hidden="true" />
      <div class="page-hero__overlay"></div>
    </div>
    <div class="container page-hero__content text-center">
      <span class="eyebrow animate-in" style="color: var(--color-cream-light);">Reflections & Insights</span>
      <h1 class="animate-in animate-in--delay-1" style="color: var(--color-warm-white);">The Blog</h1>
      <p class="page-hero__lead animate-in animate-in--delay-2">
        Honest reflections, biblical encouragement, and thoughtful guidance on living with intention, uncovering your purpose, and walking faithfully through every season.
      </p>
    </div>
  </section>

  <!-- ===== Newsletter Subscription Section ===== -->
  <section class="section section--cream" id="subscribe">
    <div class="container container--narrow text-center" data-animate>
      <span class="eyebrow">Stay Connected</span>
      <h2>Get new posts <span class="serif-italic">in your inbox</span></h2>
      <div class="divider divider--center"></div>
      <p class="lead" style="margin: 0 auto var(--space-md); max-width: 620px;">
        Join my email list for coaching reflections, encouragement, new program announcements, and new blog posts straight to your inbox.
      </p>
      
      <div class="newsletter-embed">
        <iframe
          width="540"
          height="305"
          src="https://605cc0c5.sibforms.com/v2/serve/MUIFACWjVtHYWNHsrp199GwdRBCOSL1q43sBk6lb4S7pwj0htyOfjTITyLBbJGHrVxCQ_4JBfeLU5cEpj-UBS1KcIPGOE-3GgMzqO21cXK-8nB2n-OmH7g-3yckExX40ZzNaOVfH6hTgNdAgK_axtd07GTM_I41C6cvn1wanXGtZ1M2x4vqkagFRRe2eWzr2MRdvjEono3Yu50GONw=="
          frameborder="0"
          scrolling="auto"
          allowfullscreen
          style="display: block;margin-left: auto;margin-right: auto;max-width: 100%;"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ===== Upcoming Reflections Section ===== -->
  <section class="section section--white" id="articles">
    <div class="container">
      <div class="text-center" data-animate>
        <span class="eyebrow">Upcoming Articles</span>
        <h2>Themes & <span class="serif-italic">reflections</span></h2>
        <div class="divider divider--center"></div>
        <p class="lead" style="margin: 0 auto var(--space-xl); max-width: 600px;">
          New long-form essays and coaching reflections are on the way. Here is a glimpse of what is coming to the blog.
        </p>
      </div>

      <div class="blog-grid">
        <!-- Article Card 1 -->
        <article class="blog-card card" data-animate>
          <div class="blog-card__header">
            <span class="blog-card__tag">Life Transitions</span>
            <span class="blog-card__badge">Coming Soon</span>
          </div>
          <h3 class="blog-card__title">Navigating the In-Between: Why Transitions Feel So Disorienting</h3>
          <p class="blog-card__excerpt">
            Whether you just relocated across the country, started a new career, or stepped into motherhood, the space between what was and what will be is rarely comfortable. Why the intentional pause matters most when life feels unsettled.
          </p>
          <div class="blog-card__footer">
            <span class="blog-card__status">Subscribe above to read first</span>
          </div>
        </article>

        <!-- Article Card 2 -->
        <article class="blog-card card" data-animate>
          <div class="blog-card__header">
            <span class="blog-card__tag">Intentional Living</span>
            <span class="blog-card__badge">Coming Soon</span>
          </div>
          <h3 class="blog-card__title">Peeling Back Distractions: Exposing the Lies That Keep Us Stuck</h3>
          <p class="blog-card__excerpt">
            This world is full of noise that subtly dictates how we spend our energy and who we think we should be. Exploring the habits and rhythms that keep us chained, and learning how to respond rather than merely react.
          </p>
          <div class="blog-card__footer">
            <span class="blog-card__status">Subscribe above to read first</span>
          </div>
        </article>

        <!-- Article Card 3 -->
        <article class="blog-card card" data-animate>
          <div class="blog-card__header">
            <span class="blog-card__tag">Faith & Purpose</span>
            <span class="blog-card__badge">Coming Soon</span>
          </div>
          <h3 class="blog-card__title">Don't Merely Exist: Grounding Your Worth in Who God Created You to Be</h3>
          <p class="blog-card__excerpt">
            We are meant to be powerful tools on this earth in the Hands of our Father. Discovering clarity around your convictions starts when you learn to silence self-doubt and step forward with quiet confidence.
          </p>
          <div class="blog-card__footer">
            <span class="blog-card__status">Subscribe above to read first</span>
          </div>
        </article>
      </div>

      <!-- Encouragement Banner -->
      <div class="blog-banner card" data-animate>
        <div class="blog-banner__content">
          <span class="eyebrow" style="color: var(--color-terracotta);">Have a topic or question in mind?</span>
          <h3>Looking for support in your current season?</h3>
          <p>
            Coaching is a space to grapple with decisions, beliefs, and habits in an impactful way. If you are navigating a transition and want personalized support, let's connect.
          </p>
        </div>
        <div class="blog-banner__action">
          <a href="/contact" class="btn btn--primary">Book a Free Discovery Call</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* ===== Page Hero ===== */
  .page-hero {
    position: relative;
    padding-top: calc(var(--nav-height) + var(--space-2xl));
    padding-bottom: var(--space-2xl);
    background: var(--color-charcoal);
    overflow: hidden;
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
  }

  .page-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(58, 53, 48, 0.7) 0%, rgba(58, 53, 48, 0.9) 100%);
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .page-hero__lead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: rgba(255, 253, 249, 0.85);
    margin: var(--space-md) auto 0;
  }

  /* ===== Newsletter Embed ===== */
  .newsletter-embed {
    margin-top: var(--space-lg);
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .newsletter-embed iframe {
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 30px rgba(58, 53, 48, 0.08);
    border: 1px solid var(--color-cream-dark);
    background: #ffffff;
    width: 100%;
    max-width: 540px;
    min-height: 305px;
  }

  /* ===== Blog Grid ===== */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    background: var(--color-warm-white);
    border: 1px solid var(--color-cream-dark);
    border-radius: var(--radius-lg);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(58, 53, 48, 0.08);
  }

  .blog-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-sm);
    gap: var(--space-xs);
  }

  .blog-card__tag {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-terracotta);
  }

  .blog-card__badge {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.55rem;
    background: var(--color-cream);
    color: var(--color-sage-dark);
    border-radius: var(--radius-full);
  }

  .blog-card__title {
    font-size: 1.35rem;
    line-height: 1.35;
    margin-bottom: var(--space-sm);
    color: var(--color-charcoal);
  }

  .blog-card__excerpt {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text-light);
    flex-grow: 1;
    margin-bottom: var(--space-md);
  }

  .blog-card__footer {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-cream);
  }

  .blog-card__status {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--color-sage-dark);
  }

  /* ===== Encouragement Banner ===== */
  .blog-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: var(--space-xl);
    background: var(--color-cream);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-cream-dark);
  }

  .blog-banner__content {
    max-width: 650px;
  }

  .blog-banner__content h3 {
    font-size: 1.6rem;
    margin-top: 0.3rem;
    margin-bottom: var(--space-xs);
  }

  .blog-banner__content p {
    font-size: 0.98rem;
    color: var(--color-text-light);
    margin: 0;
  }

  .blog-banner__action {
    flex-shrink: 0;
  }

  /* ===== Responsive ===== */
  @media (max-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .blog-banner {
      flex-direction: column;
      text-align: center;
      gap: var(--space-md);
    }
  }

  @media (max-width: 768px) {
    .page-hero {
      padding-top: calc(var(--nav-height) + var(--space-lg));
      padding-bottom: var(--space-xl);
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }

    .blog-banner {
      padding: var(--space-lg);
    }
  }
</style>
