---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Thank You" description="Thank you for reaching out to Rachel Connell Coaching.">
  <Header />

  <main class="thank-you-page">
    <section class="hero-section">
      <img src="/images/botanical-texture.jpg" alt="" class="hero__bg-img" aria-hidden="true" />
      <div class="container hero__content text-center">
        <div class="hero__text" data-animate="fade-up">
          <h1 class="heading-1">Thank You</h1>
          <p class="body-large mt-6 mb-8 max-w-2xl mx-auto">
            Your message has been successfully sent. I look forward to reading it and will get back to you shortly!
          </p>
          <a href="/" class="btn btn-primary">Return Home</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .thank-you-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .hero-section {
    position: relative;
    padding: 8rem 0;
    overflow: hidden;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__bg-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    opacity: 0.4;
  }

  .text-center {
    text-align: center;
  }

  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }
</style>
