---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Email Signature | Rachel Connell Coaching" description="Email signature templates and generator for Rachel Connell Coaching.">
  <Header />

  <section class="page-hero">
    <div class="page-hero__bg">
      <img src="/images/botanical-texture.jpg" alt="" aria-hidden="true" />
      <div class="page-hero__overlay"></div>
    </div>
    <div class="container page-hero__content text-center">
      <span class="eyebrow animate-in" style="color: var(--color-cream-light);">Brand Assets</span>
      <h1 class="animate-in animate-in--delay-1" style="color: var(--color-warm-white);">Email Signatures</h1>
      <p class="lead animate-in animate-in--delay-2" style="color: rgba(255, 253, 249, 0.85); max-width: 620px; margin: var(--space-sm) auto 0;">
        Beautiful, branded email signatures designed specifically for Gmail and modern email clients.
      </p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container container--narrow">

      <!-- How to Install Banner -->
      <div class="install-guide card" style="margin-bottom: var(--space-2xl); border-left: 4px solid var(--color-terracotta);">
        <h3 style="margin-bottom: var(--space-xs); color: var(--color-charcoal); font-size: 1.3rem;">
          How to install in Gmail (30 seconds):
        </h3>
        <ol style="margin: var(--space-sm) 0 0 1.2rem; color: var(--color-text); line-height: 1.8; font-size: 0.95rem;">
          <li>Choose your favorite design below and click the <strong>"Copy Signature"</strong> button.</li>
          <li>Open <strong>Gmail</strong> and click the <strong>Gear icon</strong> (top right) &rarr; <strong>See all settings</strong>.</li>
          <li>In the <strong>General</strong> tab, scroll down to <strong>Signature</strong> and click <strong>Create new</strong> (or select your existing one).</li>
          <li>Click into the text box and press <strong>Cmd + V</strong> (Mac) or <strong>Ctrl + V</strong> (Windows) to paste.</li>
          <li>Under <em>Signature defaults</em>, select your signature for "For new emails use" and "On reply/forward use".</li>
          <li>Scroll to the bottom of the page and click <strong>Save Changes</strong>. You're done!</li>
        </ol>
      </div>

      <!-- ================= OPTION 1 ================= -->
      <div class="signature-card card" style="margin-bottom: var(--space-2xl); background: #ffffff; padding: var(--space-xl);">
        <div class="signature-header">
          <div>
            <span class="badge" style="background: var(--color-sage-light); color: var(--color-charcoal); padding: 4px 10px; border-radius: 99px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Option 1 &bull; Recommended</span>
            <h3 style="margin-top: var(--space-xs); font-size: 1.35rem; color: var(--color-charcoal);">The Botanical Signature</h3>
            <p style="color: var(--color-text-light); font-size: 0.9rem; margin-bottom: var(--space-md);">Features your authentic botanical lily mark, sage divider, elegant typography, and a discovery call button.</p>
          </div>
          <button class="btn btn--primary copy-btn" data-target="sig-1">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 6px;"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            Copy Signature
