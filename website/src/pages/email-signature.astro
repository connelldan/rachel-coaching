                      <table cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <td align="center" style="background-color: #7A8668; border-radius: 4px; padding: 7px 15px;">
                            <a href="https://www.rachelconnellcoaching.com/contact" target="_blank" style="font-family: 'Outfit', Helvetica, Arial, sans-serif; font-size: 11px; font-weight: 500; color: #FFFFFF; text-decoration: none; letter-spacing: 0.5px; display: inline-block;">
                              Schedule a Discovery Call &rarr;
                            </a>
                          </td>
