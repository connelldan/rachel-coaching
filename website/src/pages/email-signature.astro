                      <span style="font-family: 'Outfit', Helvetica, Arial, sans-serif; font-size: 11.5px; font-weight: 500; text-transform: uppercase; letter-spacing: 1.2px; color: #B06A3B;">Certified Professional Coach</span>
                      <span style="color: #8B9E7D; font-size: 11px; padding: 0 5px;">•</span>
                      <span style="font-family: 'Outfit', Helvetica, Arial, sans-serif; font-size: 11.5px; color: #7A8668; letter-spacing: 0.5px;">ICF Level 2</span>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding: 0 0 10px 0;">
                      <span style="font-size: 12px; color: #6B6560;">Rachel Connell Coaching</span>
                      <span style="color: #8B9E7D; padding: 0 4px;">|</span>
                      <span style="font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-size: 13px; color: #7A8668;">Live Intentionally</span>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding: 0 0 12px 0;">
                      <table cellpadding="0" cellspacing="0" border="0" style="font-size: 12px;">
                        <tr>
                          <td style="padding-right: 14px;">
                            <a href="https://www.rachelconnellcoaching.com" target="_blank" style="color: #4A443D; text-decoration: none; font-size: 12px;">
                              <img src="https://www.rachelconnellcoaching.com/images/icon-web.png" width="13" height="13" alt="" style="display: inline-block; vertical-align: -2px; margin-right: 4px; border: 0;" />
                              <span>rachelconnellcoaching.com</span>
                            </a>
                          </td>
                          <td>
                            <a href="https://instagram.com/rachelconnellcoaching" target="_blank" style="color: #4A443D; text-decoration: none; font-size: 12px;">
                              <img src="https://www.rachelconnellcoaching.com/images/icon-instagram.png" width="13" height="13" alt="" style="display: inline-block; vertical-align: -2px; margin-right: 4px; border: 0;" />
                              <span>@rachelconnellcoaching</span>
                            </a>
