---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Free Resources" description="Free coaching tools, workbooks, and guides from Rachel Connell Coaching to help you move forward with purpose and intention.">
  <Header />

  <!-- ===== Page Hero ===== -->
  <section class="page-hero">
    <div class="page-hero__bg">
      <img src="/images/botanical-leaf-texture-background.jpg" alt="" aria-hidden="true" />
      <div class="page-hero__overlay"></div>
    </div>
    <div class="container page-hero__content text-center">
      <span class="eyebrow animate-in" style="color: var(--color-cream-light);">Tools & Reflection</span>
      <h1 class="animate-in animate-in--delay-1" style="color: var(--color-warm-white);">Free Resources</h1>
      <p class="page-hero__lead animate-in animate-in--delay-2">
        Practical guides and reflection workbooks designed to help you gain clarity, align with your convictions, and step forward with confidence.
      </p>
    </div>
  </section>

  <!-- ===== Resources Gallery Section ===== -->
  <section class="section section--white">
    <div class="container">
      <div class="resources-intro text-center" data-animate>
        <span class="eyebrow">Workbooks & Guides</span>
        <h2>Explore Free <span class="serif-italic">Resources</span></h2>
        <div class="divider divider--center"></div>
      </div>

      <div class="resources-grid">
        <!-- Rooted to Flourish Workbook Card -->
        <a href="/free-resources/rooted-to-flourish" class="resource-card card" data-animate>
          <div class="resource-card__image-wrap">
            <img 
              src="/images/rooted-to-flourish-workbook-cover.jpg" 
              alt="Rooted to Flourish: A reflection workbook for undergraduate women"
              class="resource-card__image"
            />
            <div class="resource-card__overlay">
              <span class="btn btn--white btn--sm">View & Download</span>
            </div>
          </div>
          <div class="resource-card__body">
            <span class="resource-card__badge">Free Workbook</span>
            <h3 class="resource-card__title">Rooted to Flourish</h3>
            <p class="resource-card__subtitle">A reflection workbook for undergraduate women</p>
            <p class="resource-card__desc">
              A journey of honest reflection, challenging and encouraging you to take ownership of walking the path God has laid out for you.
            </p>
            <div class="resource-card__link">
              <span>Access Workbook →</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* ===== Page Hero ===== */
  .page-hero {
    position: relative;
    padding-top: calc(var(--nav-height) + var(--space-2xl));
    padding-bottom: var(--space-2xl);
    background: var(--color-charcoal);
    overflow: hidden;
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
  }

  .page-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(58, 53, 48, 0.7) 0%, rgba(58, 53, 48, 0.9) 100%);
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .page-hero__lead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: rgba(255, 253, 249, 0.85);
    margin: var(--space-md) auto 0;
  }

  /* ===== Resources Gallery ===== */
  .resources-intro {
    max-width: 600px;
    margin: 0 auto var(--space-2xl);
  }

  .resources-grid {
    display: flex;
    justify-content: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .resource-card {
    display: flex;
    flex-direction: column;
    max-width: 380px;
    background: var(--color-warm-white);
    border: 1px solid var(--color-cream-dark);
    border-radius: var(--radius-xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .resource-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(58, 53, 48, 0.12);
  }

  .resource-card__image-wrap {
    position: relative;
    overflow: hidden;
    background: var(--color-cream);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--space-lg);
  }

  .resource-card__image {
    width: 220px;
    height: auto;
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
    transition: transform var(--transition-base);
  }

  .resource-card:hover .resource-card__image {
    transform: scale(1.03);
  }

  .resource-card__overlay {
    position: absolute;
    inset: 0;
    background: rgba(58, 53, 48, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .resource-card:hover .resource-card__overlay {
    opacity: 1;
  }

  .resource-card__body {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .resource-card__badge {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-terracotta);
    margin-bottom: var(--space-xs);
  }

  .resource-card__title {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
    color: var(--color-charcoal);
  }

  .resource-card__subtitle {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--color-sage-dark);
    font-weight: 500;
    margin-bottom: var(--space-sm);
  }

  .resource-card__desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-light);
    margin-bottom: var(--space-md);
    flex-grow: 1;
  }

  .resource-card__link {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-terracotta);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .resource-card:hover .resource-card__link {
    color: var(--color-terracotta-dark);
  }

  @media (max-width: 768px) {
    .page-hero {
      padding-top: calc(var(--nav-height) + var(--space-lg));
      padding-bottom: var(--space-xl);
    }
  }
</style>
