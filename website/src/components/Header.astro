---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/events', label: 'Events' },
  { href: '/free-resources', label: 'Free Resources' },
];
---

<header class="site-header" id="site-header">
  <nav class="nav container">
    <a href="/" class="nav__logo" aria-label="Rachel Connell Coaching Home">
      <svg class="nav__logo-flower" width="28" height="28" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Lily petals -->
        <path d="M32 8 C28 16, 18 22, 14 30 C10 38, 16 44, 24 40 C28 38, 30 34, 32 28Z" fill="#8B9E7D" opacity="0.7"/>
        <path d="M32 8 C36 16, 46 22, 50 30 C54 38, 48 44, 40 40 C36 38, 34 34, 32 28Z" fill="#8B9E7D" opacity="0.55"/>
        <path d="M32 8 C30 18, 22 26, 20 36 C18 42, 24 46, 30 42 C32 40, 32 36, 32 28Z" fill="#A6B89A" opacity="0.5"/>
        <path d="M32 8 C34 18, 42 26, 44 36 C46 42, 40 46, 34 42 C32 40, 32 36, 32 28Z" fill="#A6B89A" opacity="0.4"/>
        <!-- Center stamens -->
        <path d="M30 24 C28 18, 26 14, 27 10" stroke="#B06A3B" stroke-width="1" stroke-linecap="round" opacity="0.6"/>
        <path d="M34 24 C36 18, 38 14, 37 10" stroke="#B06A3B" stroke-width="1" stroke-linecap="round" opacity="0.6"/>
        <path d="M32 22 C32 16, 32 12, 32 8" stroke="#B06A3B" stroke-width="1" stroke-linecap="round" opacity="0.6"/>
        <circle cx="27" cy="10" r="1.5" fill="#B06A3B" opacity="0.5"/>
        <circle cx="32" cy="8" r="1.5" fill="#B06A3B" opacity="0.5"/>
        <circle cx="37" cy="10" r="1.5" fill="#B06A3B" opacity="0.5"/>
        <!-- Leaf -->
        <path d="M38 42 C42 46, 48 52, 50 56 C44 54, 38 48, 36 44Z" fill="#6B7D5E" opacity="0.6"/>
      </svg>
      <div class="nav__logo-text">
        <span class="nav__logo-name">Rachel Connell</span>
        <span class="nav__logo-sub">Coaching</span>
      </div>
    </a>

    <button class="nav__toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
      <span class="nav__toggle-bar"></span>
      <span class="nav__toggle-bar"></span>
      <span class="nav__toggle-bar"></span>
    </button>

    <ul class="nav__links" id="nav-links">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['nav__link', { 'nav__link--active': currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href="/contact" class="btn btn--primary nav__cta">Book a Call</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  const header = document.getElementById('site-header');

  function toggleMenu(force?: boolean) {
    const isCurrentlyExpanded = toggle?.getAttribute('aria-expanded') === 'true';
    const nextState = force !== undefined ? force : !isCurrentlyExpanded;

    toggle?.setAttribute('aria-expanded', String(nextState));
    header?.classList.toggle('site-header--menu-open', nextState);
    links?.classList.toggle('nav__links--open', nextState);
    document.body.classList.toggle('nav-open', nextState);
  }

  toggle?.addEventListener('click', () => toggleMenu());

  // Close mobile nav when clicking a link
  links?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      toggleMenu(false);
    });
  });

  // Shrink header on scroll (only if menu isn't open)
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const current = window.scrollY;
    if (current > 60) {
      header?.classList.add('site-header--scrolled');
    } else {
      header?.classList.remove('site-header--scrolled');
    }
    lastScroll = current;
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(250, 246, 241, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(176, 106, 59, 0.06);
    transition: all var(--transition-base);
    height: var(--nav-height);
  }

  .site-header--scrolled {
    height: 65px;
    box-shadow: 0 2px 20px rgba(58, 53, 48, 0.06);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    z-index: 1001;
    text-decoration: none;
  }

  .nav__logo:hover {
    color: inherit;
  }

  .nav__logo-flower {
    flex-shrink: 0;
    transition: all var(--transition-base);
  }

  .site-header--scrolled .nav__logo-flower {
    width: 22px;
    height: 22px;
  }

  .nav__logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    transition: all var(--transition-base);
  }

  .nav__logo-name {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-terracotta);
    transition: font-size var(--transition-base);
  }

  .nav__logo-sub {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.35em;
    color: var(--color-sage);
    transition: font-size var(--transition-base);
  }

  .site-header--scrolled .nav__logo-name {
    font-size: 0.8rem;
  }

  .site-header--scrolled .nav__logo-sub {
    font-size: 0.55rem;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text);
    position: relative;
    padding: 0.25rem 0;
    transition: color var(--transition-base);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1.5px;
    background: var(--color-terracotta);
    transition: width var(--transition-base);
  }

  .nav__link:hover::after,
  .nav__link--active::after {
    width: 100%;
  }

  .nav__link:hover,
  .nav__link--active {
    color: var(--color-terracotta);
  }

  .nav__cta {
    font-size: 0.75rem;
    padding: 0.7rem 1.6rem;
  }

  .nav__social-item {
    display: flex;
    align-items: center;
  }

  .nav__instagram-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-light);
    padding: 0.35rem;
    border-radius: var(--radius-sm);
    transition: color var(--transition-base), transform var(--transition-base);
  }

  .nav__instagram-link:hover {
    color: var(--color-terracotta);
    transform: translateY(-1px);
  }

  .nav__instagram-text {
    display: none;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    z-index: 1001;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .nav__toggle-bar {
    width: 24px;
    height: 2px;
    background: var(--color-charcoal);
    border-radius: 2px;
    transition: all var(--transition-base);
  }

  @media (max-width: 900px) {
    .site-header {
      transition: height 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease;
    }

    .site-header--menu-open {
      height: 100dvh !important;
      background: var(--color-cream-light) !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      overflow-y: auto;
      box-shadow: 0 10px 40px rgba(58, 53, 48, 0.1);
    }

    .nav {
      flex-wrap: wrap;
      align-content: flex-start;
      height: 100%;
    }

    .nav__logo {
      height: var(--nav-height);
    }

    .site-header--scrolled .nav__logo {
      height: 65px;
    }

    .nav__toggle {
      display: flex;
      height: var(--nav-height);
    }

    .site-header--scrolled .nav__toggle {
      height: 65px;
    }

    .nav__links {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1.75rem;
      padding: 3rem 1.5rem 4rem;
      margin: 0;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .site-header--menu-open .nav__links {
      display: flex;
      opacity: 1;
      transform: translateY(0);
    }

    .nav__link {
      font-size: 1.3rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      padding: 0.4rem 1rem;
      text-align: center;
      display: inline-block;
    }

    .nav__instagram-link {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 1.1rem;
      font-family: var(--font-sans);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text);
      padding: 0.4rem 1rem;
    }

    .nav__instagram-text {
      display: inline;
    }

    .nav__cta {
      margin-top: 1rem;
      font-size: 0.85rem;
      padding: 0.85rem 2.2rem;
      letter-spacing: 0.15em;
    }

    /* Hamburger → X transform */
    [aria-expanded="true"] .nav__toggle-bar:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }
    [aria-expanded="true"] .nav__toggle-bar:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }
    [aria-expanded="true"] .nav__toggle-bar:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }
  }
</style>
